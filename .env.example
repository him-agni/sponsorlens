# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Leave blank to use the defaults in backend/app/config.py (Nemotron 3 Nano and Ultra).
# To override, pick IDs from: uv run python -m scripts.list_models
NANO_MODEL=
ULTRA_MODEL=

# Tavily (https://app.tavily.com)
TAVILY_API_KEY=

# LangSmith (https://smith.langchain.com), optional: only for scripts/experiment.py, run locally.
LANGSMITH_API_KEY=
